# Copiar a .env y completar. No versionar .env.
POSTGRES_USER=carpeta
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=carpeta_viva
FUSEKI_ADMIN_PASSWORD=cambiar
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
ARCHIVOS_CLAVE_MAESTRA=generar-con-fernet
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8080"]

# Numero de la Policia de Infancia y Adolescencia mostrado en la pantalla de
# emergencia de evasion (ADR-0009). Un solo operador/municipio por ahora
# (Fundacion Fundar, Florencia); cambiar por el numero real antes de produccion.
POLICIA_INFANCIA_TELEFONO=cambiar-numero-real

# Asistente de IA (ADR-0010). Proveedor/modelo del LLM externo, intercambiable detras de
# ProveedorLLM (backend/app/core/ia_llm.py). NUNCA poner una clave real en este archivo de
# ejemplo.
IA_LLM_PROVEEDOR=anthropic
IA_LLM_MODELO=claude-haiku-5-5
ANTHROPIC_API_KEY=cambiar-por-una-clave-real-nunca-en-el-repo
# Modelo de embeddings local (sentence-transformers), ejecutado en el servidor, sin llamada
# externa (ADR-0010, seccion 1.3).
IA_EMBEDDINGS_MODELO=intfloat/multilingual-e5-small
IA_EMBEDDINGS_VERSION=1
# Seudonimizacion activa por defecto (ADR-0010, seccion 1.4/1.6); no pasar a false sin la
# pasada de NER (pendiente) y habilitacion explicita de admin/seguridad con contrato de datos
# reales (ADR-0002 punto 4).
IA_ANONIMIZADO_POR_DEFECTO=true
IA_INDEXAR_AUTOMATICAMENTE=true
IA_INDEXACION_PENDIENTE_UMBRAL_MINUTOS=60

# Ruta de los estáticos compilados del frontend (ya no se usa: el servicio `frontend` del
# docker-compose.yml compila dentro de su propio contenedor con frontend/Dockerfile).
FRONTEND_DIST=./frontend/dist/frontend/browser

# Repositorios remotos (para scripts/bootstrap)
BACKEND_REPO_URL=https://github.com/canon4/carpeta-viva-backend.git
FRONTEND_REPO_URL=https://github.com/canon4/carpeta-viva-frontend.git
