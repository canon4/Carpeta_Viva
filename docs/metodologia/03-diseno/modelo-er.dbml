// Carpeta Viva - Modelo entidad-relacion (DBML, importable en https://dbdiagram.io)
// Estado: revision Alembic 0010 (head). 31 tablas.
// Fuentes: backend/app/core/models.py y backend/app/modules/*/models.py; coherente con
//   backend/migrations/versions/0001 a 0010 y con docs/metodologia/03-diseno/script-bd.sql.
// Convenciones:
//   - Todas las PK son uuid generadas por la aplicacion (excepto configuracion_sistema.clave).
//   - "default:" solo se declara cuando existe server_default en la migracion. Los defaults
//     que aplica el codigo (Python) se indican en la nota de la columna como "default app".
//   - Las restricciones CHECK van en la nota de cada tabla (DBML no las modela).
//   - Sin borrado fisico: se usan banderas (activo, oculta, retirado, consumido, estado).
//   - Solo datos sinteticos.

Project carpeta_viva {
  database_type: 'PostgreSQL'
  Note: '''
  Sistema de gestion documental para hogares sustitutos (ICBF).
  Extensiones requeridas: vector (pgvector), pgcrypto.
  Patron *_History: menores_history, asignaciones_history, documentos_versiones.
  '''
}

// ---------------------------------------------------------------------------
// Identidad, organizacion y auditoria
// ---------------------------------------------------------------------------

Table usuarios {
  id uuid [pk]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null, note: 'Hash Argon2']
  rol varchar(30) [not null, note: 'madre, profesional, defensor, coordinador, auditor, admin (validado en codigo, sin CHECK)']
  activo boolean [not null, note: 'default app: true']
  zona_id uuid [ref: > zonas.id, note: 'Solo coordinador']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    email [unique, name: 'ix_usuarios_email']
  }
}

Table zonas {
  id uuid [pk]
  nombre varchar(100) [not null, unique]
  descripcion varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table madres_sustitutas {
  id uuid [pk]
  usuario_id uuid [unique, ref: - usuarios.id, note: 'Una madre, un usuario (1 a 1)']
  nombres varchar(120) [not null]
  apellidos varchar(120) [not null]
  numero_identificacion varchar(30) [not null, unique]
  direccion varchar(255)
  telefono varchar(30)
  estado_certificacion varchar(30) [not null, note: 'default app: pendiente (sin CHECK)']
  firma_ref varchar(255) [note: 'Referencia a la firma unica; hoy en texto plano (ADR-0008, pendiente). Punto abierto 5']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table profesionales {
  id uuid [pk]
  usuario_id uuid [unique, ref: - usuarios.id, note: 'Un profesional, un usuario (1 a 1)']
  nombres varchar(120) [not null]
  apellidos varchar(120) [not null]
  cargo varchar(40) [not null, note: 'defensor, psicosocial, nutricion, trabajo_social (sin CHECK)']
  especialidad varchar(120)
  numero_registro varchar(60)
  telefono varchar(30)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table hogares_sustitutos {
  id uuid [pk]
  zona_id uuid [not null, ref: > zonas.id]
  madre_id uuid [ref: > madres_sustitutas.id, note: 'Se asigna por PUT; nullable']
  capacidad_maxima integer [not null, note: 'default app: 6']
  fecha_habilitacion date
  estado varchar(30) [not null, note: 'default app: activo (sin CHECK)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    zona_id [name: 'ix_hogares_sustitutos_zona_id']
  }
}

Table auditoria_accesos {
  id uuid [pk]
  usuario_id uuid [ref: > usuarios.id]
  accion varchar(60) [not null]
  recurso varchar(255)
  menor_id uuid [note: 'Referencia logica: SIN clave foranea']
  ip varchar(64)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    usuario_id [name: 'ix_auditoria_accesos_usuario_id']
    accion [name: 'ix_auditoria_accesos_accion']
    menor_id [name: 'ix_auditoria_accesos_menor_id']
    created_at [name: 'ix_auditoria_accesos_created_at']
  }

  Note: '''
  Solo insercion por convencion de la aplicacion (core/audit.registrar_acceso); no hay trigger ni permisos que lo impidan.
  Particionado por fecha previsto en ADR-0004, aun no hecho.
  '''
}

// ---------------------------------------------------------------------------
// Expediente del menor
// ---------------------------------------------------------------------------

Table menores {
  id uuid [pk]
  nombres varchar(120) [not null]
  apellidos varchar(120) [not null]
  fecha_nacimiento date [not null]
  genero varchar(20)
  tipo_documento varchar(30)
  numero_documento varchar(50)
  estado_actual varchar(30) [not null, note: 'default app: activo']
  version integer [not null, note: 'default app: 1. Sube con cada snapshot en menores_history']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    numero_documento [unique, name: 'ix_menores_numero_documento', note: 'Indice unico parcial: WHERE numero_documento IS NOT NULL']
  }

  Note: '''
  CHECK ck_menores_tipo_documento:
    tipo_documento IS NULL OR tipo_documento IN ('registro_civil','tarjeta_identidad','cedula','pasaporte','sin_documento')
  CHECK ck_menores_estado_actual:
    estado_actual IN ('activo','egresado','evadido','fallecido')
  '''
}

Table menores_history {
  id uuid [pk]
  menor_id uuid [not null, ref: > menores.id]
  version integer [not null, note: 'Version que queda reemplazada']
  nombres varchar(120) [not null]
  apellidos varchar(120) [not null]
  fecha_nacimiento date [not null]
  genero varchar(20)
  tipo_documento varchar(30)
  numero_documento varchar(50)
  estado_actual varchar(30) [not null]
  cambiado_por uuid [ref: > usuarios.id]
  motivo varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    menor_id [name: 'ix_menores_history_menor_id']
  }

  Note: 'Patron *_History: snapshot de la fila anterior de menores (ADR-0007).'
}

Table menores_familiares {
  id uuid [pk]
  menor_id uuid [not null, ref: > menores.id]
  parentesco varchar(20) [not null]
  nombres varchar(120)
  numero_identificacion varchar(50)
  telefono varchar(30)
  direccion varchar(255)
  estado_vital varchar(20) [not null]
  observaciones text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    menor_id [name: 'ix_menores_familiares_menor_id']
  }

  Note: '''
  Seccion siempre sensible ("familia"). Sin tabla _History (ADR-0007 sec. 3): la auditoria cubre los cambios.
  CHECK ck_menores_familiares_parentesco: parentesco IN ('padre','madre','otro')
  CHECK ck_menores_familiares_estado_vital: estado_vital IN ('vivo','fallecido','desconocido')
  '''
}

Table permisos_expediente {
  id uuid [pk]
  menor_id uuid [not null, ref: > menores.id]
  seccion varchar(20) [not null]
  usuario_id uuid [not null, ref: > usuarios.id, note: 'Madre habilitada']
  otorgado_por uuid [not null, ref: > usuarios.id, note: 'Defensor asignado']
  activo boolean [not null, default: true]
  notas varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (menor_id, seccion, usuario_id) [unique, name: 'uq_permisos_expediente_menor_seccion_usuario']
    menor_id [name: 'ix_permisos_expediente_menor_id']
    usuario_id [name: 'ix_permisos_expediente_usuario_id']
  }

  Note: '''
  ACL por seccion sensible (ADR-0007). Revocar = activo false; se reactiva en vez de duplicar.
  CHECK ck_permisos_expediente_seccion: seccion IN ('familia','salud','psicosocial')
  '''
}

Table menores_profesionales {
  id uuid [pk]
  menor_id uuid [not null, ref: > menores.id]
  profesional_id uuid [not null, ref: > profesionales.id]
  rol_asignado varchar(40) [not null, note: 'defensor, psicosocial, nutricion, trabajo_social (sin CHECK)']

  Indexes {
    (menor_id, profesional_id, rol_asignado) [unique, note: 'Restriccion UNIQUE sin nombre en la migracion']
    menor_id [name: 'ix_menores_profesionales_menor_id']
    profesional_id [name: 'ix_menores_profesionales_profesional_id']
  }

  Note: 'Quien atiende a cada menor: de aqui salen permisos, paneles y destinatarios de alertas. Ningun endpoint la escribe hoy (solo script de datos sinteticos).'
}

// ---------------------------------------------------------------------------
// Asignaciones y traslados
// ---------------------------------------------------------------------------

Table asignaciones {
  id uuid [pk]
  menor_id uuid [not null, ref: > menores.id]
  hogar_id uuid [not null, ref: > hogares_sustitutos.id]
  fecha_inicio date [not null]
  fecha_fin date
  estado varchar(30) [not null, note: 'vigente o cerrada (sin CHECK). default app: vigente']
  version integer [not null, default: 1]
  tipo_movimiento varchar(20) [not null, default: 'ingreso']
  acta_referencia varchar(255)
  motivo varchar(255)
  registrado_por uuid [ref: > usuarios.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    hogar_id [name: 'ix_asignaciones_hogar_id']
    menor_id [name: 'ix_asignaciones_menor_id']
  }

  Note: '''
  CHECK ck_asignaciones_tipo_movimiento: tipo_movimiento IN ('ingreso','traslado','egreso')
  Regla de aplicacion: un menor tiene como maximo una asignacion vigente (no hay indice unico parcial en la base).
  '''
}

Table asignaciones_history {
  id uuid [pk]
  asignacion_id uuid [not null, ref: > asignaciones.id]
  version integer [not null]
  menor_id uuid [not null, ref: > menores.id]
  hogar_id uuid [not null, ref: > hogares_sustitutos.id]
  fecha_inicio date [not null]
  fecha_fin date
  estado varchar(30) [not null]
  tipo_movimiento varchar(20) [not null]
  acta_referencia varchar(255)
  motivo varchar(255)
  cambiado_por uuid [ref: > usuarios.id]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    asignacion_id [name: 'ix_asignaciones_history_asignacion_id']
    menor_id [name: 'ix_asignaciones_history_menor_id']
  }

  Note: 'Patron *_History: snapshot de la fila anterior de asignaciones (cierre, traslado, correccion de fechas).'
}

// ---------------------------------------------------------------------------
// Gestion documental
// ---------------------------------------------------------------------------

Table documentos {
  id uuid [pk]
  menor_id uuid [ref: > menores.id, note: 'Exactamente uno de menor_id u hogar_id; lo valida la aplicacion, no hay CHECK']
  hogar_id uuid [ref: > hogares_sustitutos.id]
  categoria varchar(60) [not null, note: 'Valida contra catalogos_opciones (grupos categoria_documento_menor y categoria_documento_hogar); sin CHECK desde la migracion 0009']
  titulo varchar(255) [not null]
  estado_flujo varchar(30) [not null, note: 'default app: borrador']
  version integer [not null, note: 'default app: 1']
  referencia_archivo varchar(255) [note: 'Ruta relativa del .enc cifrado con Fernet']
  hash_sha256 varchar(64) [note: 'Sobre el contenido en claro']
  sensible boolean [not null, note: 'default app: false; la aplicacion lo fija true si la categoria mapea a una seccion sensible']
  creado_por uuid [not null, ref: > usuarios.id]
  nombre_original varchar(255) [not null]
  mime_type varchar(100) [not null]
  tamanio_bytes integer [not null]
  revisado_por uuid [ref: > usuarios.id]
  revisado_en timestamptz
  motivo_devolucion varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    menor_id [name: 'ix_documentos_menor_id']
    hogar_id [name: 'ix_documentos_hogar_id']
    (menor_id, categoria) [name: 'ix_documentos_menor_id_categoria']
  }

  Note: '''
  CHECK ck_documentos_estado_flujo: estado_flujo IN ('borrador','en_revision','aprobado','devuelto')
  El CHECK ck_documentos_categoria existio en 0003 y se retiro en 0009 (ADR-0013).
  '''
}

Table documentos_versiones {
  id uuid [pk]
  documento_id uuid [not null, ref: > documentos.id]
  version integer [not null, note: 'Version que queda reemplazada']
  referencia_archivo varchar(255)
  hash_sha256 varchar(64)
  nombre_original varchar(255)
  mime_type varchar(100)
  tamanio_bytes integer
  estado_flujo varchar(30) [not null]
  creado_por uuid [ref: > usuarios.id]
  revisado_por uuid [ref: > usuarios.id]
  motivo_devolucion varchar(255)
  comprimida boolean [not null, default: false, note: 'true si la copia historica de una imagen se recomprimio (ADR-0011)']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    documento_id [name: 'ix_documentos_versiones_documento_id']
  }

  Note: 'Patron *_History: snapshot de la version reemplazada (ADR-0008 sec. 3).'
}

Table reportes {
  id uuid [pk]
  menor_id uuid [not null, ref: > menores.id]
  autor_id uuid [not null, ref: > usuarios.id]
  tipo_autor varchar(30) [not null, note: 'Rol del autor (profesional o defensor)']
  tipo_reporte varchar(60) [not null, note: 'informe_medico, informe_psicosocial, informe_nutricion, informe_trabajo_social, seguimiento (mapeo en codigo, sin CHECK)']
  contenido jsonb [not null, note: 'default app: objeto vacio']
  referencia_archivo varchar(255) [note: 'Valor del cliente; no pasa por almacenamiento.guardar']
  version integer [not null, note: 'default app: 1']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    menor_id [name: 'ix_reportes_menor_id']
  }

  Note: 'Informe clinico de seguimiento (no confundir con el modulo reportes, cuya tabla es informes_generados). Append-only: una correccion es una fila nueva (ADR-0008 sec. 3).'
}

// ---------------------------------------------------------------------------
// Vida del hogar: inventario y alimentos
// ---------------------------------------------------------------------------

Table inventario_items {
  id uuid [pk]
  hogar_id uuid [not null, ref: > hogares_sustitutos.id]
  tipo varchar(20) [not null]
  descripcion varchar(255) [not null]
  cantidad integer [not null, default: 1]
  estado varchar(20) [not null, default: 'bueno']
  registrado_por uuid [not null, ref: > usuarios.id]
  recibido boolean [not null, default: true, note: 'false = pedido del coordinador aun sin llegar (ADR-0014)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    hogar_id [name: 'ix_inventario_items_hogar_id']
  }

  Note: '''
  CHECK ck_inventario_items_tipo: tipo IN ('cama','mueble','otro')
  CHECK ck_inventario_items_estado: estado IN ('bueno','regular','malo','retirado')
  Sin borrado fisico: retirado.
  '''
}

Table inventario_item_fotos {
  id uuid [pk]
  item_id uuid [not null, ref: > inventario_items.id]
  referencia_archivo varchar(255) [not null, note: 'Ruta relativa del .enc (mismo cifrado que documentos)']
  mime_type varchar(100) [not null]
  tamanio_bytes integer [not null]
  subido_por uuid [not null, ref: > usuarios.id]
  creado_en timestamptz [not null, default: `now()`]
  declaracion_sin_menores boolean [not null, default: true, note: 'Declaracion auditable de que la foto no muestra a ningun NNA']
  oculta boolean [not null, default: false, note: 'Remediacion solo admin; nunca se borra']

  Indexes {
    item_id [name: 'ix_inventario_item_fotos_item_id']
  }

  Note: 'Evidencia fotografica de la recepcion de un item (ADR-0014). Sin versionado.'
}

Table hogar_convivientes {
  id uuid [pk]
  hogar_id uuid [not null, ref: > hogares_sustitutos.id]
  nombres varchar(120) [not null]
  relacion_con_madre varchar(60) [not null]
  fecha_desde date
  observaciones varchar(255)
  activo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    hogar_id [name: 'ix_hogar_convivientes_hogar_id']
  }

  Note: 'Personas que viven en el hogar, distintas de los NNA asignados y de la madre.'
}

Table hogar_red_apoyo {
  id uuid [pk]
  hogar_id uuid [not null, ref: > hogares_sustitutos.id]
  nombres varchar(120) [not null]
  relacion varchar(60) [not null]
  telefono varchar(30)
  observaciones varchar(255)
  activo boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    hogar_id [name: 'ix_hogar_red_apoyo_hogar_id']
  }
}

Table alimentos_checklist_items {
  id uuid [pk]
  hogar_id uuid [not null, ref: > hogares_sustitutos.id]
  descripcion varchar(255) [not null]
  perecedero boolean [not null, default: true]
  unidad_por_defecto varchar(20)
  activo boolean [not null, default: true]
  creado_por uuid [not null, ref: > usuarios.id]
  creado_en timestamptz [not null, default: `now()`]

  Indexes {
    hogar_id [name: 'ix_alimentos_checklist_items_hogar_id']
  }

  Note: 'Producto reutilizable del mercado (ADR-0014 sec. 4).'
}

Table alimentos_items {
  id uuid [pk]
  hogar_id uuid [not null, ref: > hogares_sustitutos.id]
  descripcion varchar(255) [not null]
  fecha_ingreso date [not null]
  perecedero boolean [not null]
  fecha_vencimiento date [note: 'Obligatoria si perecedero (regla de aplicacion, alimentos.domain)']
  cantidad float [not null]
  unidad varchar(20)
  consumido boolean [not null, default: false]
  registrado_por uuid [not null, ref: > usuarios.id]
  checklist_item_id uuid [ref: > alimentos_checklist_items.id, note: 'Producto del checklist del que viene la compra; nullable']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    hogar_id [name: 'ix_alimentos_items_hogar_id']
  }

  Note: 'Cada compra es una fila independiente (historial completo). Sin borrado fisico: consumido.'
}

// ---------------------------------------------------------------------------
// Citas y alertas
// ---------------------------------------------------------------------------

Table citas {
  id uuid [pk]
  menor_id uuid [not null, ref: > menores.id]
  tipo varchar(30) [not null]
  fecha_hora timestamptz [not null]
  lugar varchar(255)
  notas text [note: 'Se oculta (null) si el solicitante no tiene permiso de seccion para el tipo de cita']
  estado varchar(20) [not null, default: 'pendiente']
  registrado_por uuid [not null, ref: > usuarios.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    menor_id [name: 'ix_citas_menor_id']
  }

  Note: '''
  CHECK ck_citas_tipo: tipo IN ('medica','psicosocial','reunion_familia','otro')
  CHECK ck_citas_estado: estado IN ('pendiente','cumplida','no_asistio')
  Sin tabla _History (ADR-0009 sec. 2): la auditoria cubre los cambios. El sistema no asigna citas, solo recuerda.
  '''
}

Table alertas {
  id uuid [pk]
  tipo varchar(30) [not null]
  menor_id uuid [not null, ref: > menores.id]
  origen varchar(20) [not null]
  generada_por uuid [ref: > usuarios.id, note: 'null si es automatica']
  descripcion varchar(255) [not null]
  detalle json [note: 'JSON simple (no jsonb)']
  estado varchar(20) [not null, default: 'activa']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    menor_id [name: 'ix_alertas_menor_id']
  }

  Note: '''
  CHECK ck_alertas_tipo: tipo IN ('evasion','visita_vencida','documento_faltante','indexacion_pendiente')  (ampliado en 0006)
  CHECK ck_alertas_origen: origen IN ('manual','automatica')
  CHECK ck_alertas_estado: estado IN ('activa','cerrada')
  Sin updated_at: no se edita, solo se cierra.
  '''
}

Table alertas_destinatarios {
  id uuid [pk]
  alerta_id uuid [not null, ref: > alertas.id]
  usuario_id uuid [not null, ref: > usuarios.id]
  visto_en timestamptz [note: 'Cuando el destinatario vio la alerta']
  notificado_en timestamptz [note: 'Reservado para aviso adicional SMS o push; siempre NULL hoy. Punto abierto 7']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (alerta_id, usuario_id) [unique, name: 'uq_alertas_destinatarios_alerta_usuario']
    alerta_id [name: 'ix_alertas_destinatarios_alerta_id']
    usuario_id [name: 'ix_alertas_destinatarios_usuario_id']
  }
}

// ---------------------------------------------------------------------------
// Configuracion administrable (ADR-0013)
// ---------------------------------------------------------------------------

Table catalogos_opciones {
  id uuid [pk]
  grupo varchar(60) [not null]
  valor varchar(100) [not null]
  etiqueta varchar(200) [not null]
  orden integer [not null, default: 0]
  activo boolean [not null, default: true]
  seccion_acceso varchar(20) [note: 'familia, salud, psicosocial o null (basica). Validado en la aplicacion, sin CHECK. Inmutable tras crear']
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz
  actualizado_por uuid [ref: > usuarios.id]

  Indexes {
    (grupo, valor) [unique, name: 'uq_catalogos_opciones_grupo_valor']
    grupo [name: 'ix_catalogos_opciones_grupo']
  }

  Note: 'Sin borrado fisico: una opcion se desactiva (activo false). Semilla 0009: categoria_documento_menor y categoria_documento_hogar.'
}

Table configuracion_sistema {
  clave varchar(100) [pk]
  valor text [note: 'Texto; cada lector lo convierte al tipo declarado en configuracion.domain']
  actualizado_en timestamptz
  actualizado_por uuid [ref: > usuarios.id]

  Note: 'Parametros clave/valor editables por admin (por ejemplo telefono_policia_infancia, migrado desde configuracion_alertas en 0009).'
}

// ---------------------------------------------------------------------------
// Asistente de IA
// ---------------------------------------------------------------------------

Table fragmentos_documento {
  id uuid [pk]
  documento_id uuid [ref: > documentos.id]
  reporte_id uuid [ref: > reportes.id]
  menor_id uuid [ref: > menores.id, note: 'Denormalizado para acotar la busqueda; NO sustituye la autorizacion']
  hogar_id uuid [ref: > hogares_sustitutos.id, note: 'Denormalizado, igual que menor_id']
  seccion varchar(20) [note: 'familia, salud, psicosocial o null']
  version_documento integer [not null]
  orden integer [not null]
  texto text [not null, note: 'Texto del fragmento en claro (contenido de expediente)']
  embedding vector(384) [not null, note: 'Modelo local multilingual-e5-small']
  modelo_embedding varchar(100) [not null, note: 'nombre@version, para reindexar si cambia']
  creado_en timestamptz [not null, default: `now()`]

  Indexes {
    documento_id [name: 'ix_fragmentos_documento_documento_id']
    reporte_id [name: 'ix_fragmentos_documento_reporte_id']
    menor_id [name: 'ix_fragmentos_documento_menor_id']
    hogar_id [name: 'ix_fragmentos_documento_hogar_id']
    (documento_id, version_documento, orden) [unique, name: 'uq_fragmentos_documento_documento_version_orden']
    (reporte_id, version_documento, orden) [unique, name: 'uq_fragmentos_documento_reporte_version_orden']
  }

  Note: '''
  Indice adicional ix_fragmentos_documento_embedding_hnsw: USING hnsw (embedding vector_cosine_ops). DBML no modela hnsw.
  CHECK ck_fragmentos_documento_documento_xor_reporte:
    (documento_id IS NOT NULL AND reporte_id IS NULL) OR (documento_id IS NULL AND reporte_id IS NOT NULL)
  CHECK ck_fragmentos_documento_seccion: seccion IS NULL OR seccion IN ('familia','salud','psicosocial')
  Los UNIQUE hacen idempotente el reintento de indexacion (ADR-0010 sec. 1.3).
  '''
}

Table ia_consultas {
  id uuid [pk]
  usuario_id uuid [not null, ref: > usuarios.id]
  pregunta text [not null]
  menor_id uuid [ref: > menores.id]
  hogar_id uuid [ref: > hogares_sustitutos.id]
  fragmentos_usados jsonb [not null, note: 'Fuentes citadas; default app: lista vacia']
  respuesta text [not null, note: 'Contiene datos ya restituidos: es contenido de expediente']
  modelo varchar(100) [not null]
  proveedor varchar(50) [not null]
  anonimizado boolean [not null, note: 'default app: true']
  sin_resultado boolean [not null, note: 'default app: false']
  duracion_ms integer
  creado_en timestamptz [not null, default: `now()`]

  Indexes {
    usuario_id [name: 'ix_ia_consultas_usuario_id']
    menor_id [name: 'ix_ia_consultas_menor_id']
    hogar_id [name: 'ix_ia_consultas_hogar_id']
  }

  Note: 'Auditoria obligatoria de cada respuesta del asistente (ADR-0002 punto 7).'
}

// ---------------------------------------------------------------------------
// Reportes exportados y archivo
// ---------------------------------------------------------------------------

Table informes_generados {
  id uuid [pk]
  usuario_id uuid [not null, ref: > usuarios.id]
  nivel varchar(20) [not null]
  filtros jsonb [not null, note: 'zona_id, menor_id, madre_id y secciones_incluidas congeladas al exportar']
  formato varchar(10) [not null]
  referencia_archivo varchar(255) [note: 'Ruta relativa del .enc']
  generado_en timestamptz [not null, default: `now()`]

  Indexes {
    usuario_id [name: 'ix_informes_generados_usuario_id']
  }

  Note: '''
  CHECK ck_informes_generados_nivel: nivel IN ('general','zona','menor','madre')
  CHECK ck_informes_generados_formato: formato IN ('json','pdf','csv')
  Solo se escribe fila al exportar; las consultas en pantalla quedan en auditoria_accesos.
  '''
}

Table expedientes_archivo {
  id uuid [pk]
  menor_id uuid [not null, unique, ref: - menores.id, note: 'Un expediente de archivo por menor (1 a 1)']
  estado varchar(20) [not null, note: 'default app: activo']
  archivado_en timestamptz
  archivado_por uuid [ref: > usuarios.id]
  motivo varchar(255)
  zona_id uuid [ref: > zonas.id, note: 'Denormalizada del ultimo hogar del menor, para el alcance del coordinador']
  paquete_referencia varchar(255)
  paquete_hash varchar(64) [note: 'Hash del manifiesto']
  destino varchar(255) [not null, note: 'Provisional: almacenamiento local cifrado. Punto abierto 1']
  enviado_en timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    menor_id [unique, name: 'ix_expedientes_archivo_menor_id']
    zona_id [name: 'ix_expedientes_archivo_zona_id']
  }

  Note: '''
  CHECK ck_expedientes_archivo_estado: estado IN ('activo','archivado')
  Sin retener_hasta ni purga: falta la tabla de retencion y la base legal (Punto abierto 2).
  '''
}

// ---------------------------------------------------------------------------
// Grupos (para el lienzo de dbdiagram.io)
// ---------------------------------------------------------------------------

TableGroup identidad_organizacion_y_auditoria {
  usuarios
  zonas
  madres_sustitutas
  profesionales
  hogares_sustitutos
  auditoria_accesos
}

TableGroup expediente_del_menor {
  menores
  menores_history
  menores_familiares
  permisos_expediente
  menores_profesionales
}

TableGroup asignaciones_y_traslados {
  asignaciones
  asignaciones_history
}

TableGroup gestion_documental {
  documentos
  documentos_versiones
  reportes
}

TableGroup vida_del_hogar {
  inventario_items
  inventario_item_fotos
  hogar_convivientes
  hogar_red_apoyo
  alimentos_checklist_items
  alimentos_items
}

TableGroup citas_y_alertas {
  citas
  alertas
  alertas_destinatarios
}

TableGroup configuracion_administrable {
  catalogos_opciones
  configuracion_sistema
}

TableGroup asistente_de_ia {
  fragmentos_documento
  ia_consultas
}

TableGroup reportes_y_archivo {
  informes_generados
  expedientes_archivo
}
